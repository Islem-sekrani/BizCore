<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gestion.controllers.EvenementController"
      spacing="12">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Créer / Modifier un Événement"
           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

    <TextField fx:id="txtTitre" promptText="Titre *"/>
    <TextArea fx:id="txtDescription" promptText="Description détaillée" prefRowCount="4"/>
    <TextField fx:id="txtLieu" promptText="Lieu"/>
    <TextField fx:id="txtCapacite" promptText="Capacité maximale"/>
    <TextField fx:id="txtPrix" promptText="Prix (DT)"/>
    <TextField fx:id="txtImageUrl" promptText="Image URL"/>

    <!-- NEW: Dates -->
    <DatePicker fx:id="dpDateDebut" promptText="Date de début"/>
    <DatePicker fx:id="dpDateFin" promptText="Date de fin"/>

    <ComboBox fx:id="cbStatut" promptText="Statut">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="planifie"/>
                <String fx:value="en_cours"/>
                <String fx:value="termine"/>
                <String fx:value="annule"/>
            </FXCollections>
        </items>
    </ComboBox>

    <HBox spacing="10">
        <Button text="Ajouter" onAction="#ajouter"/>
        <Button text="Modifier" onAction="#modifier"/>
        <Button text="Supprimer" onAction="#supprimer"/>
        <Button text="Annuler" onAction="#annuler"/>
    </HBox>

</VBox>
