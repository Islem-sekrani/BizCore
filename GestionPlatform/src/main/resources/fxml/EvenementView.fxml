<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gestion.controllers.EvenementController"
      spacing="12"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- ===== TITLE (smaller) ===== -->
    <Label text="Gestion des Événements"
           style="-fx-font-size: 20px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #1E8449;"/>

    <!-- ===== TABLE (smaller height) ===== -->


    <!-- ===== FORM TITLE ===== -->
    <Label text="Créer / Modifier"
           style="-fx-font-size: 16px;
                  -fx-text-fill: #1E8449;
                  -fx-font-weight: bold;"/>

    <!-- FORM (compact) -->
    <TextField fx:id="txtTitre" promptText="Titre"/>
    <TextArea fx:id="txtDescription" promptText="Description" prefRowCount="2"/>

    <HBox spacing="8">
        <VBox spacing="3">
            <Label text="Début"/>
            <DatePicker fx:id="dpDateDebut"/>
        </VBox>
        <VBox spacing="3">
            <Label text="Fin"/>
            <DatePicker fx:id="dpDateFin"/>
        </VBox>
    </HBox>

    <TextField fx:id="txtLieu" promptText="Lieu"/>
    <TextField fx:id="txtCapacite" promptText="Capacité"/>
    <TextField fx:id="txtPrix" promptText="Prix"/>
    <ComboBox fx:id="cbStatut" promptText="Statut"/>

    <!-- ===== BUTTONS ALWAYS VISIBLE ===== -->
    <HBox spacing="10">

        <Button text="Ajouter" onAction="#ajouter"
                style="-fx-background-color: #2ECC71;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 5;"/>

        <Button text="Modifier" onAction="#modifier"
                style="-fx-background-color: #58D68D;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 5;"/>


        <Button text="Annuler" onAction="#annuler"
                style="-fx-background-color: #ECF0F1;
                       -fx-font-weight: bold;
                       -fx-background-radius: 5;"/>
    </HBox>

</VBox>
