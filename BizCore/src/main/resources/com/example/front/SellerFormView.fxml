<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" stylesheets="@styles/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.front.controllers.SellerFormController">
    <content>
        <VBox alignment="CENTER" style="-fx-padding: 60 50; -fx-background-color: #F8FAFC;">
           <children>
              <VBox maxWidth="800.0" spacing="40.0" styleClass="form-container">
                 <children>
                    <!-- Header Section -->
                    <VBox spacing="10.0" style="-fx-border-color: transparent transparent -app-border transparent; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 30 0;">
                        <children>
                            <Label styleClass="form-title" text="Dites au monde ce que vous offrez" />
                            <Label text="Partagez votre expertise et commencez à générer des revenus dès aujourd'hui." style="-fx-text-fill: -app-text-secondary; -fx-font-size: 16px;" />
                        </children>
                    </VBox>
                    
                    <!-- Form Fields -->
                    <VBox spacing="30.0">
                        <HBox spacing="30.0">
                            <!-- Column 1 -->
                            <VBox spacing="25.0" HBox.hgrow="ALWAYS">
                                <VBox spacing="10.0">
                                   <Label styleClass="form-label" text="Type de Service *" />
                                   <ComboBox fx:id="serviceType" maxWidth="Infinity" styleClass="form-input" promptText="Choisir une catégorie..." />
                                </VBox>
                                
                                <VBox spacing="10.0">
                                   <Label styleClass="form-label" text="Prix de départ (TND) *" />
                                   <TextField fx:id="servicePrice" promptText="Ex: 250.00" styleClass="form-input" />
                                </VBox>
                            </VBox>
                            
                            <!-- Column 2 -->
                            <VBox spacing="25.0" HBox.hgrow="ALWAYS">
                                <VBox spacing="10.0">
                                   <Label styleClass="form-label" text="Titre de votre offre *" />
                                   <TextField fx:id="serviceTitle" promptText="Ex: Site E-commerce Professionnel" styleClass="form-input" />
                                </VBox>
                                
                                <VBox spacing="10.0">
                                   <Label styleClass="form-label" text="Lien vers une image illustrative" />
                                   <TextField fx:id="serviceImageUrl" promptText="https://images.unsplash.com/..." styleClass="form-input" />
                                </VBox>
                            </VBox>
                        </HBox>

                        <VBox spacing="10.0">
                           <Label styleClass="form-label" text="Description détaillée de vos services *" />
                           <TextArea fx:id="serviceDescription" prefHeight="200.0" promptText="Décrivez ici ce que vous proposez précisément : fonctionnalités, outils utilisés, livrables finaux et délais moyens de réalisation." styleClass="form-input" wrapText="true" />
                        </VBox>
                    </VBox>
                    
                    <!-- Submit Button -->
                    <VBox alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                        <Button mnemonicParsing="false" onAction="#handlePublish" maxWidth="400.0" styleClass="button-primary" text="PUBLIER MON ANNONCE" style="-fx-font-size: 16px; -fx-padding: 18 0; -fx-letter-spacing: 1px;" />
                        <Label text="* Tous les champs marqués d'une étoile sont obligatoires." style="-fx-text-fill: -app-text-secondary; -fx-font-size: 12px; -fx-padding: 15 0 0 0;" />
                    </VBox>
                 </children>
              </VBox>
           </children>
        </VBox>
    </content>
</ScrollPane>
