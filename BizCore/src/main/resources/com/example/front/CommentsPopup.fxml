<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: white; -fx-border-color: #17BB9C; -fx-border-width: 2;" stylesheets="@styles/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.front.controllers.CommentsPopupController" prefWidth="400.0" prefHeight="500.0">
    <children>
        <Label text="Commentaires" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A2332;" />
        
        <Label fx:id="productNameLabel" text="Nom du Produit" style="-fx-font-size: 14px; -fx-text-fill: #666666;" />
        
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <content>
                <VBox fx:id="commentsList" spacing="10.0" style="-fx-background-color: transparent;" />
            </content>
        </ScrollPane>
        
        <VBox spacing="8.0">
            <Label text="Votre avis :" style="-fx-font-weight: bold;" />
            <TextArea fx:id="commentInput" promptText="Écrivez votre commentaire ici..." prefRowCount="3" wrapText="true" styleClass="form-input" />
            <Button text="Envoyer" onAction="#handleSubmitComment" styleClass="button-accent" maxWidth="Infinity" />
            <Button text="Fermer" onAction="#handleClose" style="-fx-background-color: #f0f0f0; -fx-text-fill: #333333; -fx-cursor: hand;" maxWidth="Infinity" />
        </VBox>
    </children>
</VBox>
