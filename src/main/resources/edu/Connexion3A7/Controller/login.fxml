<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="CENTER" spacing="0" prefWidth="500" prefHeight="600"
      style="-fx-background-color: #F5F6FA;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.Connexion3A7.Controller.login">

    <Region VBox.vgrow="ALWAYS" />

    <!-- Login Card -->
    <VBox alignment="CENTER" spacing="20" maxWidth="380"
          style="-fx-background-color: white; -fx-background-radius: 16;
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 5);
                 -fx-padding: 40 35 40 35;">

        <!-- Logo circle -->
        <StackPane>
            <Circle radius="35" style="-fx-fill: #2ECC9B;" />
            <Label text="B" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" />
        </StackPane>

        <Label text="Bizcore" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" />
        <Label text="Connectez-vous a votre compte" style="-fx-font-size: 12px; -fx-text-fill: #95A5A6;" />

        <!-- Email field -->
        <VBox spacing="5" maxWidth="300">
            <Label text="Email" style="-fx-text-fill: #5D6D7E; -fx-font-size: 12px; -fx-font-weight: bold;" />
            <TextField fx:id="email" promptText="votre@email.com"
                       style="-fx-background-color: #F8F9FA; -fx-border-color: #E0E0E0;
                              -fx-border-radius: 8; -fx-background-radius: 8;
                              -fx-padding: 10 14; -fx-font-size: 13px;" />
        </VBox>

        <!-- Password field -->
        <VBox spacing="5" maxWidth="300">
            <Label text="Mot de passe" style="-fx-text-fill: #5D6D7E; -fx-font-size: 12px; -fx-font-weight: bold;" />
            <PasswordField fx:id="mdp" promptText="••••••••"
                           style="-fx-background-color: #F8F9FA; -fx-border-color: #E0E0E0;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 10 14; -fx-font-size: 13px;" />
        </VBox>

        <!-- Login button -->
        <Button text="Se connecter" onAction="#handleLogin" maxWidth="300" prefHeight="40"
                style="-fx-background-color: #2ECC9B; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-effect: dropshadow(three-pass-box, rgba(46,204,155,0.3), 6, 0, 0, 2);" />

        <!-- Error label -->
        <Label fx:id="errorLabel" text="" style="-fx-text-fill: #E74C3C; -fx-font-size: 12px;" />
    </VBox>

    <Region VBox.vgrow="ALWAYS" />
</VBox>
