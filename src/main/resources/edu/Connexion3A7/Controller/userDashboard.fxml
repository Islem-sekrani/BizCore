<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="650.0" prefWidth="1050.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.Connexion3A7.Controller.UserDashboardController">

    <!-- ==================== Main dashboard (layer 0) ==================== -->
    <BorderPane>

        <!-- ======================== LEFT SIDEBAR ======================== -->
        <left>
            <VBox id="sidebar" prefWidth="270" spacing="0">

                <!-- Logo Section -->
                <VBox id="logoPane" alignment="CENTER" spacing="4">
                    <ImageView fitHeight="161.0" fitWidth="193.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@images/logo.png" />
                        </image>
                    </ImageView>
                </VBox>

                <!-- NAVIGATION Section Label -->
                <Label id="sectionLabel" text="NAVIGATION" />

                <!-- Navigation Buttons -->
                <VBox spacing="2">
                    <padding><Insets left="15" right="15" /></padding>

                    <Button maxWidth="Infinity" onAction="#handleCoachingClick" styleClass="nav-button-active" text="  🎯  COACHING" />

                    <Button maxWidth="Infinity" onAction="#handleEvenementsClick" styleClass="nav-button" text="  📅  ÉVÉNEMENTS" />

                    <Button maxWidth="Infinity" onAction="#handleBlogClick" styleClass="nav-button" text="  📝  BLOG" />

                    <Button maxWidth="Infinity" onAction="#handleProduitsClick" styleClass="nav-button" text="  🛒  PRODUITS" />
                </VBox>

                <!-- Spacer -->
                <Region VBox.vgrow="ALWAYS" />

                <!-- Logout Button -->
                <VBox spacing="2">
                    <padding><Insets bottom="10" left="15" right="15" /></padding>
                    <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="nav-button" text="  🚪  DÉCONNEXION" />
                </VBox>

                <!-- User Footer -->
                <VBox id="adminPane" spacing="2">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane>
                            <Circle radius="18" styleClass="avatar-circle" />
                            <Label fx:id="sidebarInitial" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="U" />
                        </StackPane>
                        <VBox spacing="1">
                            <Label id="adminNameLabel" fx:id="userNameLabel" text="Utilisateur" />
                            <Label id="adminRoleLabel" fx:id="userRoleLabel" text="Utilisateur" />
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </left>

        <!-- ======================== CENTER ======================== -->
        <center>
            <VBox>
                <!-- Top Bar -->
                <HBox id="topBar" alignment="CENTER_LEFT" prefHeight="55" spacing="12">
                    <Label id="homeIcon" text="🏠" />
                    <Label style="-fx-text-fill: #BDC3C7;" text="/" />
                    <Label id="breadcrumbLabel" fx:id="breadcrumbLabel" text="COACHING — Trouver un Coach" />
                    <Region HBox.hgrow="ALWAYS" />
                    <!-- Bell button with badge -->
                    <StackPane>
                        <Button fx:id="bellButton" onAction="#handleBellClick" styleClass="top-icon-button" text="🔔" />
                        <!-- Red dot badge — hidden by default -->
                        <Label fx:id="bellBadge" styleClass="notif-bell-badge" text="" visible="false" StackPane.alignment="TOP_RIGHT" />
                    </StackPane>
                    <Button styleClass="top-icon-button" text="⚙" />
                    <!-- Profile Icon -->
                    <StackPane>
                        <Circle fx:id="profileCircle" radius="16" style="-fx-fill: #3498DB;" />
                        <Label fx:id="profileInitials" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;" text="U" />
                    </StackPane>
                </HBox>

                <!-- ===== Master-Detail Split Content ===== -->
                <HBox spacing="0" VBox.vgrow="ALWAYS">

                    <!-- LEFT PANEL: Coach list with cards -->
                    <VBox minWidth="360" prefWidth="420" styleClass="cs-list-panel">
                        <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>

                        <!-- Header -->
                        <VBox id="tableCard" spacing="8">
                            <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label id="tableTitle" text="Coachs Disponibles" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="coachCountLabel" style="-fx-text-fill: #7F8C8D; -fx-font-size: 12px;" text="" />
                            </HBox>
                            <Label id="statusLabel" fx:id="statusLabel" text="" />
                        </VBox>

                        <!-- Scrollable coach cards -->
                        <ScrollPane fitToWidth="true" maxWidth="Infinity" prefHeight="465.0" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <padding><Insets top="10" /></padding>
                            <VBox fx:id="coachCardsContainer" spacing="10">
                                <!-- Cards added dynamically -->
                            </VBox>
                        </ScrollPane>
                    </VBox>

                    <!-- RIGHT PANEL: Availability detail -->
                    <VBox prefHeight="595.0" prefWidth="323.0" styleClass="cs-detail-panel" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="15" left="20" right="20" top="15" /></padding>

                        <!-- Placeholder when no coach selected -->
                        <VBox fx:id="noSelectionPlaceholder" alignment="CENTER" prefHeight="566.0" prefWidth="354.0" spacing="10" VBox.vgrow="ALWAYS">
                            <Label style="-fx-font-size: 48px; -fx-opacity: 0.4;" text="📅" />
                            <Label style="-fx-font-size: 16px; -fx-text-fill: #95A5A6; -fx-font-weight: bold;" text="Selectionnez un coach" />
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #BDC3C7;" text="pour afficher sa disponibilite hebdomadaire" />
                        </VBox>

                        <!-- Availability panel (hidden initially) -->
                        <VBox fx:id="availabilityPanel" managed="false" spacing="15" visible="false" VBox.vgrow="ALWAYS">

                            <!-- Selected coach name -->
                            <Label fx:id="selectedCoachLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" />

                            <!-- Week navigation -->
                            <HBox alignment="CENTER" spacing="15">
                                <Button fx:id="prevWeekBtn" onAction="#handlePrevWeek" styleClass="cs-week-btn" text="◀" />
                                <Label fx:id="weekLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" />
                                <Button fx:id="nextWeekBtn" onAction="#handleNextWeek" styleClass="cs-week-btn" text="▶" />
                            </HBox>

                            <!-- Day grid -->
                            <VBox fx:id="dayGrid" spacing="8" VBox.vgrow="ALWAYS">
                                <padding><Insets top="5" /></padding>
                            </VBox>

                            <!-- Reserve button -->
                            <HBox alignment="CENTER">
                                <padding><Insets bottom="5" top="10" /></padding>
                                <Button fx:id="reserveButton" disable="true" onAction="#handleReserve" style="-fx-font-size: 14px; -fx-padding: 12 40;" styleClass="btn-book" text="Reserver cette seance" />
                            </HBox>

                            <Label fx:id="reserveStatusLabel" alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" />
                        </VBox>
                    </VBox>

                </HBox>
            </VBox>
        </center>

    </BorderPane>

    <!-- ==================== Notification toast (layer 1) ==================== -->
    <!-- Auto-dismissed after 5 seconds; compact pill at bottom-right -->
    <VBox fx:id="notifToast" styleClass="notif-toast" managed="false" visible="false"
          maxHeight="80" prefHeight="72" fillWidth="false"
          StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin><Insets bottom="90" right="30" /></StackPane.margin>
        <HBox alignment="CENTER_LEFT" spacing="12" fillHeight="false">
            <Label styleClass="notif-toast-icon" text="✅" />
            <VBox spacing="2">
                <Label styleClass="notif-toast-title" text="Séance réservée !" />
                <Label fx:id="notifToastDetail" styleClass="notif-toast-detail" text=""
                       wrapText="false" maxWidth="280" />
            </VBox>
        </HBox>
    </VBox>

    <!-- ==================== Notification announcement panel (layer 2) ==================== -->
    <!-- Shown when user clicks the bell icon — lists the last booking details -->
    <VBox fx:id="notifPanel" styleClass="notif-panel" managed="false" visible="false"
          StackPane.alignment="TOP_RIGHT">
        <StackPane.margin><Insets top="55" right="15" /></StackPane.margin>

        <!-- Panel header -->
        <HBox styleClass="notif-panel-header" alignment="CENTER_LEFT" spacing="8">
            <Label styleClass="notif-panel-title" text="🔔  Notifications" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="notifCloseBtn" onAction="#handleCloseNotifPanel"
                    styleClass="notif-panel-close" text="✕" />
        </HBox>

        <!-- Content injected dynamically -->
        <VBox fx:id="notifPanelContent" styleClass="notif-panel-content" spacing="0" />

    </VBox>

    <!-- ==================== Chatbot overlay panel (layer 3) ==================== -->
    <VBox fx:id="chatbotOverlay" managed="false" maxHeight="520" maxWidth="380" visible="false" StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin><Insets bottom="80" right="20" /></StackPane.margin>
        <!-- chatbotPanel.fxml is loaded into this VBox dynamically -->
    </VBox>

    <!-- ==================== Floating action button (layer 4) ==================== -->
    <Button fx:id="chatbotFab" onAction="#handleChatbotToggle" styleClass="chatbot-fab" text="💬" StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin><Insets bottom="20" right="20" /></StackPane.margin>
    </Button>

</StackPane>
