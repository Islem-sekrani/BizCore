<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox alignment="TOP_CENTER" spacing="12.0" styleClass="product-card" stylesheets="@styles/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.front.controllers.ProductCardController" prefWidth="280.0" maxWidth="280.0">
   <children>
      <!-- Image Container with Placeholder -->
      <StackPane prefHeight="180.0" prefWidth="280.0" style="-fx-background-color: #F1F5F9; -fx-background-radius: 8px; -fx-border-color: -app-border; -fx-border-width: 1px; -fx-border-radius: 8px;">
         <children>
            <ImageView fx:id="productImage" fitHeight="180.0" fitWidth="280.0" pickOnBounds="true" preserveRatio="true" styleClass="product-image">
               <StackPane.margin>
                  <Insets />
               </StackPane.margin>
            </ImageView>
            <!-- Placeholder Icon when no image -->
            <Label fx:id="placeholderIcon" text="📦" style="-fx-font-size: 48px; -fx-text-fill: #94A3B8;" managed="true" visible="true" />
            
            <!-- Category Badge -->
            <HBox alignment="TOP_RIGHT" StackPane.alignment="TOP_RIGHT">
               <children>
                  <Label fx:id="categoryBadge" text="Digital" style="-fx-background-color: #14B8A6; -fx-text-fill: white; -fx-background-radius: 4px; -fx-padding: 5 12; -fx-font-size: 11px; -fx-font-weight: bold;">
                     <HBox.margin>
                        <Insets top="10.0" right="10.0" />
                     </HBox.margin>
                  </Label>
               </children>
            </HBox>
         </children>
      </StackPane>
      
      <!-- Product Info -->
      <VBox spacing="8.0" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
         <children>
            <Label fx:id="productName" text="Product Name" wrapText="true" maxWidth="260.0" style="-fx-line-spacing: 2px; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: -app-text-primary;" />
            
            <Label fx:id="productDescription" text="Description du produit..." wrapText="true" maxWidth="260.0" maxHeight="45.0" style="-fx-font-size: 13px; -fx-line-spacing: 1px; -fx-text-fill: -app-text-secondary;" />
            
            <!-- Price and Rating Row -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label fx:id="productPrice" styleClass="product-price" text="0.00 TND" />
                  <Label text="⭐" style="-fx-font-size: 12px;" />
                  <Label text="4.8" style="-fx-font-size: 12px; -fx-text-fill: -app-text-secondary;" />
               </children>
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </HBox>
         </children>
         <VBox.margin>
            <Insets left="5.0" right="5.0" />
         </VBox.margin>
      </VBox>
      
      <!-- Action Buttons -->
      <VBox spacing="8.0">
         <children>
            <Button mnemonicParsing="false" styleClass="button-primary" text="🛒 Acheter" maxWidth="Infinity" style="-fx-font-size: 14px;" />
            <Button mnemonicParsing="false" onAction="#handleComments" text="💬 Commentaires" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-border-color: -app-border; -fx-border-radius: 6px; -fx-text-fill: -app-text-secondary; -fx-cursor: hand;" />
         </children>
         <VBox.margin>
            <Insets top="5.0" />
         </VBox.margin>
      </VBox>
   </children>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
</VBox>
