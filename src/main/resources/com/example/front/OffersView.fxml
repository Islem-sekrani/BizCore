<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" stylesheets="@styles/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.front.controllers.OffersController">
   <content>
      <VBox spacing="30.0" style="-fx-background-color: transparent;" alignment="TOP_CENTER">
         <children>
            <!-- Creative Title Section -->
            <StackPane>
                <children>
                    <VBox alignment="CENTER" spacing="10.0" style="-fx-padding: 40 0 20 0;">
                       <children>
                          <Label text="Nos Meilleures Offres" styleClass="product-title" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: -app-text-primary;">
                             <style>
                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 5, 0, 0, 1);
                             </style>
                          </Label>
                          <Label text="Explorez notre catalogue exclusif de produits digitaux." style="-fx-font-size: 16px; -fx-text-fill: -app-text-secondary;" />
                       </children>
                    </VBox>
                </children>
            </StackPane>
            
            <FlowPane fx:id="productContainer" alignment="CENTER" hgap="30.0" vgap="30.0" prefWrapLength="1100.0" style="-fx-padding: 0 40 60 40;">
               <!-- Product Cards will be added here dynamically -->
            </FlowPane>
         </children>
      </VBox>
   </content>
</ScrollPane>
