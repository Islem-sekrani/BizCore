<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-padding: 30;" stylesheets="@styles/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.front.controllers.CoachingAdminController">
    <children>
        <Label styleClass="section-title" text="Gestion du Coaching" />
        
        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <tabs>
                <!-- TAB 1: GESTION DES DOMAINES -->
                <Tab text="Domaines de Coaching">
                    <content>
                        <VBox spacing="20.0" style="-fx-padding: 20 0 0 0;">
                            <!-- Formulaire Ajout Domaine -->
                            <HBox spacing="15.0" alignment="BOTTOM_LEFT" styleClass="card">
                                <children>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Nom du domaine" style="-fx-font-weight: bold;" />
                                        <TextField fx:id="domainNameField" promptText="Ex: Développement Personnel" styleClass="form-input" />
                                    </VBox>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Description" style="-fx-font-weight: bold;" />
                                        <TextField fx:id="domainDescField" promptText="Brève description..." styleClass="form-input" />
                                    </VBox>
                                    <VBox spacing="5.0" minWidth="80">
                                        <Label text="Icône" style="-fx-font-weight: bold;" />
                                        <TextField fx:id="domainIconField" promptText="Emoji" styleClass="form-input" maxWidth="80" />
                                    </VBox>
                                    <Button text="Ajouter Domaine" onAction="#handleAddDomain" styleClass="button-accent" style="-fx-min-width: 140px;" />
                                    <Button text="Vider" onAction="#handleClearDomainForm" styleClass="button-outlined" />
                                </children>
                                <padding>
                                    <Insets top="15" right="15" bottom="15" left="15"/>
                                </padding>
                            </HBox>

                            <!-- Table des Domaines -->
                            <TableView fx:id="domainsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="domainIdCol" text="ID" prefWidth="50" />
                                    <TableColumn fx:id="domainIconCol" text="Icône" prefWidth="60" style="-fx-alignment: CENTER;" />
                                    <TableColumn fx:id="domainNameCol" text="Nom" prefWidth="200" />
                                    <TableColumn fx:id="domainDescCol" text="Description" prefWidth="400" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                            
                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Button text="Supprimer le domaine sélectionné" onAction="#handleDeleteDomain" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
                            </HBox>
                        </VBox>
                    </content>
                </Tab>

                <!-- TAB 2: GESTION DES COACHS -->
                <Tab text="Coachs">
                    <content>
                        <VBox spacing="20.0" style="-fx-padding: 20 0 0 0;">
                            
                            <!-- Filtre et Recherche -->
                            <HBox spacing="15.0" alignment="CENTER_LEFT">
                                <Label text="Filtrer par Domaine :" style="-fx-font-weight: bold;" />
                                <ComboBox fx:id="filterDomainCombo" promptText="Tous les domaines" prefWidth="250" />
                                <Button text="Réinitialiser Filtre" onAction="#handleResetFilter" />
                            </HBox>

                            <!-- Table des Coachs -->
                            <TableView fx:id="coachesTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="coachNameCol" text="Nom" prefWidth="150" />
                                    <TableColumn fx:id="coachDomainCol" text="Domaine" prefWidth="150" />
                                    <TableColumn fx:id="coachExpCol" text="Expérience" prefWidth="80" />
                                    <TableColumn fx:id="coachRateCol" text="Tarif (TND/h)" prefWidth="100" />
                                    <TableColumn fx:id="coachAvailCol" text="Disponibilité" prefWidth="150" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>

                            <!-- Formulaire Ajout Coach -->
                            <VBox spacing="15.0" styleClass="card">
                                <padding>
                                    <Insets top="15" right="15" bottom="15" left="15"/>
                                </padding>
                                <Label text="Nouveau Coach" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A2332;" />
                                
                                <HBox spacing="20.0">
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Nom Complet" />
                                        <TextField fx:id="coachNameField" styleClass="form-input" />
                                    </VBox>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Domaine de Coaching" />
                                        <ComboBox fx:id="coachDomainCombo" promptText="Sélectionner..." maxWidth="Infinity" styleClass="form-input" />
                                    </VBox>
                                </HBox>

                                <HBox spacing="20.0">
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Années d'expérience" />
                                        <TextField fx:id="coachExpField" promptText="Ex: 5" styleClass="form-input" />
                                    </VBox>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Tarif Horaire (TND)" />
                                        <TextField fx:id="coachRateField" promptText="Ex: 50.0" styleClass="form-input" />
                                    </VBox>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <Label text="Disponibilité" />
                                        <TextField fx:id="coachAvailField" promptText="Ex: Weekends" styleClass="form-input" />
                                    </VBox>
                                </HBox>
                                
                                <VBox spacing="5.0">
                                    <Label text="Biographie" />
                                    <TextArea fx:id="coachBioField" prefRowCount="2" wrapText="true" styleClass="form-input" />
                                </VBox>

                                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                                     <Button text="Supprimer Sélection" onAction="#handleDeleteCoach" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
                                     <Button text="Vider Champs" onAction="#handleClearCoachForm" styleClass="button-outlined" />
                                     <Button text="Enregistrer Coach" onAction="#handleSaveCoach" styleClass="button-accent" style="-fx-font-weight: bold; -fx-padding: 10 20;" />
                                </HBox>
                            </VBox>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>
