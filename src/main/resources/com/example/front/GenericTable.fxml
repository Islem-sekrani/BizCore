<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.front.controllers.GenericTableController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <TextField fx:id="searchField" promptText="Rechercher..." styleClass="search-field" prefWidth="300.0" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" styleClass="button-primary" text="+ Ajouter" onAction="#handleAddNew" />
            <Button mnemonicParsing="false" styleClass="button-outlined" text="Actualiser" onAction="#handleRefresh" />
         </children>
      </HBox>
      <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
          <!-- Columns will be added dynamically -->
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" styleClass="button-outlined" text="Modifier" onAction="#handleEdit" />
            <Button mnemonicParsing="false" styleClass="button-accent" text="Supprimer" style="-fx-background-color: #e74c3c;" onAction="#handleDelete" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
